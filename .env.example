# MongoDB used by the Node/Express API.
MONGODB_URI=mongodb://127.0.0.1:27018/jobatlas

# Required to unlock the admin console. Use a long, unique password.
ADMIN_PASSWORD=replace-with-a-strong-password

# Used to sign short-lived admin access tokens.
ADMIN_SESSION_SECRET=replace-with-a-random-64-character-secret

# Express API settings
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# Next.js uses this server-side origin for /api rewrites.
JOBATLAS_API_ORIGIN=http://127.0.0.1:8000
