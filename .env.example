# Required to unlock the admin panel. Use a long, unique password.
ADMIN_PASSWORD=replace-with-a-strong-password

# Optional. When omitted, sessions are signed with a random key and expire on restart.
# For persistent sessions, generate a value with: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_SESSION_SECRET=replace-with-a-random-64-character-secret

# Optional web server settings
HOST=127.0.0.1
PORT=8000
